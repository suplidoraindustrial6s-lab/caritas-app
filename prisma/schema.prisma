generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Grupos de atenciÃ³n (Ej. Fe, Esperanza, Caridad, Amor, Lista de Espera)
model Group {
  id          Int           @id @default(autoincrement())
  name        String        @unique // Nombre corto creativo
  description String?
  beneficiaries Beneficiary[]
  serviceDays   ServiceDay[] // Relacin inversa
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

// Beneficiarios
model Beneficiary {
  id              Int           @id @default(autoincrement())
  fullName        String
  nationalId      String        @unique // CÃ©dula de Identidad
  phoneNumber     String?       // Telefono de contacto
  birthDate       DateTime
  placeOfBirth    String
  gender          String        // M/F
  address         String
  zone            String?       // Zona de residencia (Ej. El LimÃ³n, CaÃ±a de AzÃºcar)
  photoUrl        String?       // URL de la foto carnet
  chronicIllness  String?       // "None" or description
  hasChildren     Boolean       @default(false)
  
  // Relaciones
  groupId         Int?
  group           Group?        @relation(fields: [groupId], references: [id])
  children        Child[]
  attendances     Attendance[]
  
  observations    String?
  status          String        @default("Activo") // Activo, Inactivo, Suspendido
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

// Hijos de beneficiarios
model Child {
  id              Int           @id @default(autoincrement())
  fullName        String
  gender          String        // M/F
  nationalId      String?
  birthDate       DateTime
  isStudying      Boolean       @default(false)
  observations    String?
  
  beneficiaryId   Int
  beneficiary     Beneficiary   @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
}

// Registro de Asistencia y AtenciÃ³n
model Attendance {
  id                Int         @id @default(autoincrement())
  date              DateTime    // Fecha de atenciÃ³n
  
  beneficiaryId     Int
  beneficiary       Beneficiary @relation(fields: [beneficiaryId], references: [id])
  
  // RelaciÃ³n con la Jornada (ServiceDay)
  serviceDayId      Int?
  serviceDay        ServiceDay? @relation(fields: [serviceDayId], references: [id])

  // Detalles de la ayuda recibida
  receivedFood      Boolean     @default(false)
  foodQuantity      Int         @default(0) // Cantidad de bolsas/alimentos
  
  receivedClothes   Boolean     @default(false)
  clothesQuantity   Int         @default(0) // Cantidad de prendas
  
  receivedMedical   Boolean     @default(false)
  medicinesReceived String?     // Legacy: Lista simple
  medicinesDetail   String?     // Nuevo: JSON Stringificado [{ name: string, quantity: number }]
  
  signature         String?     // PodrÃ­a ser un path a una imagen o boolean si firmÃ³ en fÃ­sico
  status            String      @default("Presente") // Presente, Ausente

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @default(now()) @updatedAt // Para tracking de modificaciones (upsert)
}

// Jornada de Servicio (Antes Calendario)
model ServiceDay {
  id              Int       @id @default(autoincrement())
  date            DateTime  @unique // Solo un grupo por dÃ­a
  
  groupId         Int?      // Grupo asignado a la jornada
  group           Group?    @relation(fields: [groupId], references: [id])
  
  // Estado de la jornada
  status          String    @default("OPEN") // OPEN, CLOSED
  summary         String?   // JSON Stringificado: MÃ©tricas congeladas al cerrar { totalBeneficiaries, totalFood, etc. }
  closedAt        DateTime? 

  note            String?   // "Feriado", "Extraordinario", etc.
  isHoliday       Boolean   @default(false)

  attendances     Attendance[] // RelaciÃ³n inversa

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// Usuarios del Sistema (Administradores)
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String   // Hashed
  name      String?
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


// ==========================================
// MÓDULO PROGRAMA NUTRICIONAL SAMÁN (NN y MEL)
// ==========================================

// Jornadas del Programa SAMÁN
model JornadasSAMAN {
  id                Int      @id @default(autoincrement())
  fecha             DateTime @default(now())
  diocesis          String   @default("MARACAY")
  estado            String   @default("ARAGUA")
  municipio         String   @default("MBI")
  parroquiaCivil    String   @default("EL LIMÓN")
  parroquiaEclesial String   @default("LA MILAGROSA")
  centro            String   @default("MARACAY - EL LIMÓN")
  comunidad         String   @default("TEJERÍAS")
  estatus           String   @default("ABIERTA") // ABIERTA, CERRADA

  ninos             RegistroSamanNinos[]
  embarazadas       RegistroSamanEmbarazadas[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// Registro de Niños y Niñas (SAMÁN Niños)
model RegistroSamanNinos {
  id                     Int           @id @default(autoincrement())
  jornadaId              Int
  jornada                JornadasSAMAN @relation(fields: [jornadaId], references: [id], onDelete: Cascade)

  // Datos del acompañante / representante
  cedulaRepresentante    String
  edadRepresentante      String        @default("Entre 18 - 49 años")
  parentesco             String        @default("MADRE")
  grupoEtnico            String        @default("Mestizo")

  // Datos de identificación del niño/a
  nombres                String
  apellidos              String
  sexo                   String        // FEMENINO, MASCULINO
  fechaNacimiento        DateTime
  tipoIngreso            String        @default("DIAGNOSTICO INICIAL") // DIAGNOSTICO INICIAL, MONITOREO, SALIDA DE VIVERO, REINGRESO
  nroControl             Int           @default(0)
  codigoHistoria         String?

  // Condición de salud adicional
  discapacidad           String        @default("NO")
  detalleDiscapacidad    String?
  hemoglobina            Float?
  desparasitado          String        @default("NO") // SI, NO
  referidoMedico         String?       // SI, NO
  proyectoTengo          String?       // SI, NO

  // Antropometría
  pesoKg                 Float
  tallaCm                Float
  posicionMedida         String        @default("AUTO") // AUTO, ACOSTADO, DE_PIE
  longitudCabezaCm       Float?        @default(27.0) // Constante estándar Maventy (27 cm)
  cBrazoCm               Float
  edema                  String        @default("NO") // SI, NO

  // Cálculos automáticos
  edadMeses              Float
  rangoEdad              String?       // 0-6 meses, 7-23 meses, 24-59 meses
  clasificacionPb        String        @default("Adecuado")
  zScore                 Float
  estadoNutricional      String        // Adecuado, Riesgo Nutricional, Desnutrición aguda moderada, Desnutrición aguda severa

  // Tratamientos entregados y cantidades
  micronutrientes        Boolean       @default(false)
  cantMicronutrientes    Int           @default(0)
  plumpyAmarillo         Boolean       @default(false)
  cantPlumpyAmarillo     Int           @default(0)
  plumpyRojo             Boolean       @default(false)
  cantPlumpyRojo         Int           @default(0)
  plumpyMum              Boolean       @default(false)
  cantPlumpyMum          Int           @default(0)
  tratamientoProtocolo   String?       // Texto exacto para columna AG del Excel oficial
  cantidadSuministrada   Int           @default(0)
  otrosComplementos      String?

  // Datos de vivero y observaciones
  fechaInicioVivero      DateTime?
  fechaSalidaVivero      DateTime?
  zScoreEntrada          Float?
  zScoreSalida           Float?
  semanasVivero          Int?
  situacionSalida        String?
  observaciones          String?

  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  @@index([cedulaRepresentante])
  @@index([jornadaId])
}

// Registro de Mujeres Embarazadas y Lactantes (SAMÁN MEL)
model RegistroSamanEmbarazadas {
  id                       Int           @id @default(autoincrement())
  jornadaId                Int
  jornada                  JornadasSAMAN @relation(fields: [jornadaId], references: [id], onDelete: Cascade)

  // Datos de identificación
  nombre                   String
  apellido                 String
  cedula                   String
  fechaNacimiento          DateTime
  grupoEtnico              String        @default("Mestizo")
  tipoIngreso              String        @default("DIAGNOSTICO INICIAL")
  estadoEmbarazoLactancia  String        @default("EMBARAZADA") // EMBARAZADA, LACTANTE
  semanaGestacion          Int?

  // Antropometría y cálculos
  edema                    String        @default("No") // Si, No
  pesoKg                   Float
  tallaCm                  Float
  imc                      Float
  clasificacionNutricional String        // Bajo Peso, Adecuado, Sobrepeso, Obesidad
  cBrazoCm                 Float
  clasificacionPb          String        // Bajo peso, Peso Normal

  // Tratamiento y seguimiento
  desparasitada            String        @default("NO") // SI, NO
  tratamiento              String?       // Hierro+Ácido Fólico, Plumpy Mom, Micronutrientes, etc.
  cantidad                 Int           @default(0)
  plumpyMum                Boolean       @default(false)
  cantPlumpyMum            Int           @default(0)
  micronutrientes          Boolean       @default(false)
  cantMicronutrientes      Int           @default(0)
  situacionSalida          String?
  observaciones            String?

  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  @@index([cedula])
  @@index([jornadaId])
}
